# Papyrus — Environment Variables
#
# Copy to .env and fill in your values.
# Only infrastructure settings use env vars. All other settings
# (OIDC, SMTP, cloud, scanner, printer, OCR, etc.) are configured
# via the Settings UI after first login.

# ── Required ──

# PostgreSQL — required, docker compose refuses to start without it.
# Generate: openssl rand -hex 32
#
# Upgrading an existing deployment: Postgres only applies this on volume
# initialization, not on every restart. If the `papyrus` role already exists
# (a volume from before this variable was required), setting a new value
# here does NOT change its actual password -- PAPYRUS_DB_URL will fail auth
# forever. Either set this to the value already baked into the volume
# (`secret`, if you never set it explicitly before), or first run
# `ALTER USER papyrus WITH PASSWORD '<new-password>'` against the running
# database, then set this to match. See README.md's deployment section.
POSTGRES_PASSWORD=
PAPYRUS_DB_URL=postgresql+asyncpg://papyrus:${POSTGRES_PASSWORD}@localhost:5432/papyrus

# Fernet key for encrypting secrets at rest
# Generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PAPYRUS_ENCRYPTION_KEY=

# Session secret — required, startup fails without it (docker compose will
# refuse to start; a non-compose deployment hard-fails at app startup).
# Generate: openssl rand -hex 32
PAPYRUS_SESSION_SECRET=

# Public URL (used for OIDC redirect URIs and webhook URLs)
PAPYRUS_BASE_URL=https://papyrus.example.com

# ── Initial Admin Account ──
# Created on first startup if no admin user exists in the database. Leave
# PAPYRUS_ADMIN_PASSWORD blank for a dev/OIDC-only deployment -- local admin
# account creation is skipped (with a warning logged) whenever it's empty.
# Generate: openssl rand -base64 24
PAPYRUS_ADMIN_USERNAME=admin
PAPYRUS_ADMIN_PASSWORD=

# ── Optional ──

# Traefik hostname label (used in compose.yaml)
PAPYRUS_HOSTNAME=papyrus.example.com

# Development mode (auto-login without auth)
# PAPYRUS_DEV_MODE=false
